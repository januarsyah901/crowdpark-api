# Supabase Edge Functions — environment secrets
# Set via: supabase secrets set KEY=VALUE
# Or via: Supabase Dashboard → Edge Functions → Secrets

# Otomatis disediakan oleh Supabase (tidak perlu diset manual)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_ANON_KEY=your-anon-key

# Wajib diset manual
GEMINI_API_KEY=your_gemini_api_key_here

# URL ML service (Python FastAPI) — hanya perlu jika ML masih dipakai
# Jika ML di-deploy ke CapRover/VPS, isi dengan URL publiknya
# ML_SERVICE_URL=https://crowdpark-ml.your-server.com
